{
  "name": "viberacing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public-safe workspace for the Vibe Racing open-source project.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.7.x"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level moderate --registry=https://registry.npmjs.org/",
    "build:admin": "pnpm --filter @viberacing/admin run build",
    "build:contracts": "pnpm --filter @viberacing/contracts run build",
    "build:ingest": "pnpm --filter @viberacing/ingest run build",
    "build:ingest-host": "pnpm --filter @viberacing/ingest-host run build",
    "build:image:ingest": "docker build --file deploy/Dockerfile.ingest --tag viberacing-ingest:local .",
    "build:image:jobs-scheduler": "docker build --file deploy/Dockerfile.jobs-scheduler --tag viberacing-jobs-scheduler:local .",
    "build:image:migrate": "docker build --file deploy/Dockerfile.migrate --tag viberacing-migrate:local .",
    "build:image:web": "docker build --tag viberacing-web:local .",
    "build:jobs": "pnpm --filter @viberacing/jobs run build",
    "build:jobs-scheduler": "pnpm --filter @viberacing/jobs-scheduler run build",
    "build:migrate": "pnpm --filter @viberacing/migrate run build",
    "build:web": "pnpm --filter @viberacing/web run build",
    "capture:phase1-visual-baselines": "node scripts/capture-phase1-visual-baselines.mjs",
    "check:agent-skills": "node scripts/check-agent-skills.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:community": "node scripts/check-community.mjs",
    "check:codex-compatibility": "node scripts/check-codex-compatibility.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:containment-runbook": "node scripts/check-containment-runbook.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:database": "node scripts/check-database.mjs",
    "check:deletion-failure-runbook": "node scripts/check-deletion-failure-runbook.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:documentation-currentness": "node scripts/check-documentation-currentness.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:external-links:online": "node scripts/check-external-links.mjs --online",
    "check:format": "prettier --check .",
    "check:history": "node scripts/check-git-history.mjs",
    "check:ingest-host-entrypoint": "node scripts/check-ingest-host-entrypoint.mjs",
    "check:jobs-scheduler-entrypoint": "node scripts/check-jobs-scheduler-entrypoint.mjs",
    "check:migrate-entrypoint": "node scripts/check-migrate-entrypoint.mjs",
    "check:migration-runbook": "node scripts/check-migration-runbook.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:phase1-visual-baselines": "node scripts/check-phase1-visual-baselines.mjs",
    "check:publication": "node scripts/check-publication-readiness.mjs",
    "check:public": "node scripts/check-public-files.mjs --all",
    "check:public:staged": "node scripts/check-public-files.mjs --staged",
    "check:restore-runbook": "node scripts/check-restore-runbook.mjs",
    "check:rust": "node scripts/check-rust.mjs",
    "check:spelling": "node scripts/check-spelling.mjs",
    "check:web-build": "node scripts/check-web-build.mjs",
    "dev:web": "pnpm --filter @viberacing/web run dev",
    "format": "prettier --write .",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "lint:admin": "pnpm --filter @viberacing/admin run lint",
    "lint:contracts": "pnpm --filter @viberacing/contracts run lint",
    "lint:edge": "pnpm --filter @viberacing/edge run lint",
    "lint:ingest": "pnpm --filter @viberacing/ingest run lint",
    "lint:ingest-host": "pnpm --filter @viberacing/ingest-host run lint",
    "lint:jobs": "pnpm --filter @viberacing/jobs run lint",
    "lint:jobs-scheduler": "pnpm --filter @viberacing/jobs-scheduler run lint",
    "lint:migrate": "pnpm --filter @viberacing/migrate run lint",
    "lint:markdown": "markdownlint-cli2",
    "lint:web": "pnpm --filter @viberacing/web run lint",
    "test:web": "pnpm --filter @viberacing/web run test",
    "test:web:coverage": "pnpm --filter @viberacing/web run test:coverage",
    "test:web:postgres-integration": "node scripts/test-web-postgres-integration.mjs",
    "test:web:standalone": "node scripts/test-web-standalone.mjs",
    "test:web-query-plan-evidence": "node scripts/test-web-query-plan-evidence.mjs",
    "test:admin": "pnpm --filter @viberacing/admin run test",
    "test:admin:coverage": "pnpm --filter @viberacing/admin run test:coverage",
    "test:admin:postgres-integration": "node scripts/test-admin-postgres-integration.mjs",
    "test:config-check": "node scripts/test-config-check.mjs",
    "test:containment-runbook-check": "node scripts/test-containment-runbook-check.mjs",
    "test:connector:release-candidate": "node scripts/test-connector-release-candidate.mjs",
    "test:connector:windows-portable": "cargo build --release --locked --target-dir target --package viberacing-connector --bin viberacing-connector && node scripts/test-connector-windows-portable.mjs",
    "test:contracts": "pnpm --filter @viberacing/contracts run test",
    "test:contracts:coverage": "pnpm --filter @viberacing/contracts run test:coverage",
    "test:database-check": "node scripts/test-database-check.mjs",
    "test:database:integration": "node scripts/test-database-integration.mjs",
    "test:deletion-failure-runbook-check": "node scripts/test-deletion-failure-runbook-check.mjs",
    "test:documentation-currentness-check": "node scripts/test-documentation-currentness-check.mjs",
    "test:edge": "pnpm --filter @viberacing/edge run test",
    "test:edge-ingest-compatibility": "pnpm --filter @viberacing/contracts run build && pnpm --filter @viberacing/ingest run build && node scripts/test-edge-ingest-compatibility.mjs",
    "test:ingest": "pnpm --filter @viberacing/ingest run test",
    "test:ingest:coverage": "pnpm --filter @viberacing/ingest run test:coverage",
    "test:ingest:postgres-integration": "node scripts/test-ingest-postgres-integration.mjs",
    "test:ingest:signal-postgres-integration": "node scripts/test-ingest-postgres-integration.mjs --signal-process",
    "test:ingest-host": "pnpm --filter @viberacing/ingest-host run test",
    "test:ingest-host:coverage": "pnpm --filter @viberacing/ingest-host run test:coverage",
    "test:jobs": "pnpm --filter @viberacing/jobs run test",
    "test:jobs:coverage": "pnpm --filter @viberacing/jobs run test:coverage",
    "test:jobs:postgres-integration": "node scripts/test-jobs-postgres-integration.mjs",
    "test:jobs-scheduler": "pnpm --filter @viberacing/jobs-scheduler run test",
    "test:jobs-scheduler:coverage": "pnpm --filter @viberacing/jobs-scheduler run test:coverage",
    "test:jobs-scheduler:lifecycle-postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler-lifecycle",
    "test:jobs-scheduler:process-postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler-process",
    "test:jobs-scheduler:postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler",
    "test:jobs-scheduler:signal-postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler-signal-process",
    "test:jobs-scheduler:timer-postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler-timer",
    "test:jobs-scheduler:wall-clock-postgres-integration": "node scripts/test-jobs-postgres-integration.mjs --scheduler-wall-clock-process",
    "test:migrate": "pnpm --filter @viberacing/migrate run test",
    "test:migrate:coverage": "pnpm --filter @viberacing/migrate run test:coverage",
    "test:migrate:postgres-integration": "node scripts/test-migrate-postgres-integration.mjs",
    "test:migration-runbook-check": "node scripts/test-migration-runbook-check.mjs",
    "test:restore-runbook-check": "node scripts/test-restore-runbook-check.mjs",
    "typecheck:admin": "pnpm --filter @viberacing/admin run typecheck",
    "typecheck:contracts": "pnpm --filter @viberacing/contracts run typecheck",
    "typecheck:ingest": "pnpm --filter @viberacing/ingest run typecheck",
    "typecheck:ingest-host": "pnpm --filter @viberacing/ingest-host run typecheck",
    "typecheck:jobs": "pnpm --filter @viberacing/jobs run typecheck",
    "typecheck:jobs-scheduler": "pnpm --filter @viberacing/jobs-scheduler run typecheck",
    "typecheck:migrate": "pnpm --filter @viberacing/migrate run typecheck",
    "typecheck:web": "pnpm --filter @viberacing/web run typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:node": "node scripts/verify.mjs --node-only",
    "verify:release": "node scripts/verify.mjs --release",
    "verify:release:node": "node scripts/verify.mjs --release --node-only",
    "verify:web:deployment": "pnpm --filter @viberacing/contracts run build && pnpm --filter @viberacing/web run build && node scripts/test-web-standalone.mjs",
    "verify:phase1-visual-baselines": "node scripts/capture-phase1-visual-baselines.mjs --verify"
  },
  "devDependencies": {
    "cspell": "10.0.1",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.4",
    "yaml": "2.8.3"
  }
}
