{
  "name": "viberacing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public-safe workspace for the Vibe Racing open-source project.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.7.x"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level moderate --registry=https://registry.npmjs.org/",
    "build:jobs": "pnpm --filter @viberacing/jobs run build",
    "build:web": "pnpm --filter @viberacing/web run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:community": "node scripts/check-community.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:database": "node scripts/check-database.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:external-links:online": "node scripts/check-external-links.mjs --online",
    "check:format": "prettier --check .",
    "check:history": "node scripts/check-git-history.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:publication": "node scripts/check-publication-readiness.mjs",
    "check:public": "node scripts/check-public-files.mjs --all",
    "check:public:staged": "node scripts/check-public-files.mjs --staged",
    "check:rust": "node scripts/check-rust.mjs",
    "check:spelling": "node scripts/check-spelling.mjs",
    "check:web-build": "node scripts/check-web-build.mjs",
    "dev:web": "pnpm --filter @viberacing/web run dev",
    "format": "prettier --write .",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "lint:contracts": "pnpm --filter @viberacing/contracts run lint",
    "lint:jobs": "pnpm --filter @viberacing/jobs run lint",
    "lint:markdown": "markdownlint-cli2",
    "lint:web": "pnpm --filter @viberacing/web run lint",
    "test:web": "pnpm --filter @viberacing/web run test",
    "test:web:coverage": "pnpm --filter @viberacing/web run test:coverage",
    "test:architecture-check": "node scripts/test-architecture-check.mjs",
    "test:config-check": "node scripts/test-config-check.mjs",
    "test:community-check": "node scripts/test-community-check.mjs",
    "test:docs-check": "node scripts/test-docs-check.mjs",
    "test:contract-check": "node scripts/test-contract-check.mjs",
    "test:contracts": "pnpm --filter @viberacing/contracts run test",
    "test:contracts:coverage": "pnpm --filter @viberacing/contracts run test:coverage",
    "test:database-check": "node scripts/test-database-check.mjs",
    "test:database:integration": "node scripts/test-database-integration.mjs",
    "test:external-links-check": "node scripts/test-external-links-check.mjs",
    "test:history-check": "node scripts/test-git-history-check.mjs",
    "test:license-check": "node scripts/test-license-check.mjs",
    "test:jobs": "pnpm --filter @viberacing/jobs run test",
    "test:jobs:coverage": "pnpm --filter @viberacing/jobs run test:coverage",
    "test:publication-check": "node scripts/test-publication-check.mjs",
    "test:png-content-policy": "node scripts/test-png-content-policy.mjs",
    "test:public-check": "node scripts/test-public-file-check.mjs",
    "test:spelling-check": "node scripts/test-spelling-check.mjs",
    "test:web-build-check": "node scripts/test-web-build-check.mjs",
    "typecheck:contracts": "pnpm --filter @viberacing/contracts run typecheck",
    "typecheck:jobs": "pnpm --filter @viberacing/jobs run typecheck",
    "typecheck:web": "pnpm --filter @viberacing/web run typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:node": "node scripts/verify.mjs --node-only"
  },
  "devDependencies": {
    "cspell": "10.0.1",
    "markdownlint-cli2": "0.23.0",
    "prettier": "3.9.4",
    "yaml": "2.8.3"
  }
}
