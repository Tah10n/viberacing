  "components": {
    "schemas": {
      "CommunityScorePageV1": {
        "title": "CommunityScorePageV1",
        "description": "Bounded response-only Community score page with explicit self-reported trust metadata and no private identifiers, raw usage, daily detail, or exact timestamps.",
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "trustTier", "selfReported", "participants"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1, "minimum": 1, "maximum": 1 },
          "trustTier": { "type": "string", "const": "community", "minLength": 9, "maxLength": 9 },
          "selfReported": { "type": "boolean", "const": true },
          "participants": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "x-viberacing-uniqueBy": "displayPosition",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seasonStart",
                "seasonEnd",
                "scoreVersion",
                "seasonFinalized",
                "handle",
                "weeklyScore",
                "activeDays",
                "sourceCount",
                "rankPosition",
                "displayPosition"
              ],
              "properties": {
                "seasonStart": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 10,
                  "pattern": "^(?:1999-12-27|20[0-9]{2}-[0-9]{2}-[0-9]{2})$",
                  "format": "date",
                  "x-viberacing-dateMinimum": "1999-12-27",
                  "x-viberacing-dateMaximum": "2099-12-28",
                  "x-viberacing-isoWeekday": 1
                },
                "seasonEnd": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 10,
                  "pattern": "^(?:20[0-9]{2}-[0-9]{2}-[0-9]{2}|2100-01-03)$",
                  "format": "date",
                  "x-viberacing-dateMinimum": "2000-01-02",
                  "x-viberacing-dateMaximum": "2100-01-03",
                  "x-viberacing-isoWeekday": 7
                },
                "scoreVersion": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9_]{2,31}$"
                },
                "seasonFinalized": { "type": "boolean" },
                "handle": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 24,
                  "pattern": "^[a-z0-9][a-z0-9_-]{1,22}[a-z0-9]$"
                },
                "weeklyScore": { "type": "integer", "minimum": 0, "maximum": 7000 },
                "activeDays": { "type": "integer", "minimum": 0, "maximum": 7 },
                "sourceCount": { "type": "integer", "minimum": 0, "maximum": 32 },
                "rankPosition": { "type": "integer", "minimum": 1, "maximum": 32 },
                "displayPosition": { "type": "integer", "minimum": 1, "maximum": 32 }
              }
            }
          }
        }
      },
      "CommunityScoreQueryV1": {
        "title": "CommunityScoreQueryV1",
        "description": "Closed value contract for one bounded public Community score season. A future URL parser must reject duplicate parameters before applying this schema.",
        "type": "object",
        "additionalProperties": false,
        "required": ["seasonStart"],
        "properties": {
          "seasonStart": {
            "description": "Inclusive Monday season start from 1999-12-27 through 2099-12-28.",
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^(?:1999-12-27|20[0-9]{2}-[0-9]{2}-[0-9]{2})$",
            "format": "date",
            "x-viberacing-dateMinimum": "1999-12-27",
            "x-viberacing-dateMaximum": "2099-12-28",
            "x-viberacing-isoWeekday": 1
          }
        }
      },
      "ConnectorSyncResultV1": {
        "title": "ConnectorSyncResultV1",
        "description": "Non-sensitive acknowledgement for a validated connector synchronization. Internal anomaly reasons are intentionally absent.",
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "requestId", "syncId", "outcome", "acceptedEntries"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1, "minimum": 1, "maximum": 1 },
          "requestId": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^req_[A-Za-z0-9_-]{22}$"
          },
          "syncId": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^syn_[A-Za-z0-9_-]{22}$"
          },
          "outcome": {
            "type": "string",
            "enum": ["accepted", "duplicate", "quarantined"],
            "minLength": 8,
            "maxLength": 11
          },
          "acceptedEntries": { "type": "integer", "minimum": 0, "maximum": 31 }
        }
      },
      "ConnectorSyncV1": {
        "title": "ConnectorSyncV1",
        "description": "Bounded self-reported Community usage submitted by one source-bound device. Derived ranking and trust fields are server-owned and intentionally absent.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "sourceId",
          "syncId",
          "observedAt",
          "connectorVersion",
          "codexVersion",
          "dailyEntries"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1, "minimum": 1, "maximum": 1 },
          "sourceId": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^src_[A-Za-z0-9_-]{22}$"
          },
          "syncId": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^syn_[A-Za-z0-9_-]{22}$"
          },
          "observedAt": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "format": "date-time"
          },
          "connectorVersion": {
            "type": "string",
            "minLength": 5,
            "maxLength": 64,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "codexVersion": {
            "type": "string",
            "minLength": 5,
            "maxLength": 64,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "dailyEntries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 31,
            "x-viberacing-uniqueBy": "codexReportedDate",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["codexReportedDate", "tokens"],
              "properties": {
                "codexReportedDate": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 10,
                  "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
                  "format": "date"
                },
                "tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              }
            }
          }
        }
      },
      "ProblemDetailsV1": {
        "title": "ProblemDetailsV1",
        "description": "Bounded public error response that carries a request ID and stable code without stack traces, SQL details, secrets, or internal hostnames.",
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "requestId", "status", "errorCode", "title", "retryable"],
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1, "minimum": 1, "maximum": 1 },
          "requestId": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26,
            "pattern": "^req_[A-Za-z0-9_-]{22}$"
          },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "errorCode": {
            "type": "string",
            "enum": [
              "conflict",
              "forbidden",
              "internal_error",
              "invalid_request",
              "method_not_allowed",
              "not_acceptable",
              "not_found",
              "rate_limited",
              "temporarily_unavailable",
              "unauthorized",
              "validation_failed"
            ],
            "minLength": 8,
            "maxLength": 23
          },
          "title": {
            "type": "string",
            "enum": [
              "Conflict",
              "Forbidden",
              "Internal server error",
              "Invalid request",
              "Method not allowed",
              "Not acceptable",
              "Not found",
              "Rate limited",
              "Temporarily unavailable",
              "Unauthorized",
              "Validation failed"
            ],
            "minLength": 1,
            "maxLength": 23
          },
          "retryable": { "type": "boolean" }
        }
      }
    }
  },
