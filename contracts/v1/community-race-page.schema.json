{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/community-race-page.schema.json",
  "title": "CommunityRacePageV1",
  "description": "Bounded response-only Community race page. It preserves the score contract fields and may add only the participant's current active enum-only CarRecipe, without private identifiers, proposal state, timestamps, raw usage, or daily detail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trustTier", "selfReported", "participants"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "trustTier": {
      "type": "string",
      "const": "community",
      "minLength": 9,
      "maxLength": 9
    },
    "selfReported": {
      "type": "boolean",
      "const": true
    },
    "participants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "x-viberacing-uniqueBy": "displayPosition",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "x-viberacing-optionalProperties": ["carRecipe"],
        "required": [
          "seasonStart",
          "seasonEnd",
          "scoreVersion",
          "seasonFinalized",
          "handle",
          "weeklyScore",
          "activeDays",
          "sourceCount",
          "rankPosition",
          "displayPosition"
        ],
        "properties": {
          "seasonStart": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^(?:1999-12-27|20[0-9]{2}-[0-9]{2}-[0-9]{2})$",
            "format": "date",
            "x-viberacing-dateMinimum": "1999-12-27",
            "x-viberacing-dateMaximum": "2099-12-28",
            "x-viberacing-isoWeekday": 1
          },
          "seasonEnd": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^(?:20[0-9]{2}-[0-9]{2}-[0-9]{2}|2100-01-03)$",
            "format": "date",
            "x-viberacing-dateMinimum": "2000-01-02",
            "x-viberacing-dateMaximum": "2100-01-03",
            "x-viberacing-isoWeekday": 7
          },
          "scoreVersion": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9_]{2,31}$"
          },
          "seasonFinalized": {
            "type": "boolean"
          },
          "handle": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24,
            "pattern": "^[a-z0-9][a-z0-9_-]{1,22}[a-z0-9]$"
          },
          "carRecipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "chassis",
              "nose",
              "cockpit",
              "wing",
              "wheels",
              "palette",
              "trail",
              "seed"
            ],
            "properties": {
              "schemaVersion": {
                "type": "integer",
                "const": 1,
                "minimum": 1,
                "maximum": 1
              },
              "chassis": {
                "type": "string",
                "enum": ["formula", "rally", "roadster"],
                "minLength": 5,
                "maxLength": 8
              },
              "nose": {
                "type": "string",
                "enum": ["classic", "scoop", "wedge"],
                "minLength": 5,
                "maxLength": 7
              },
              "cockpit": {
                "type": "string",
                "enum": ["canopy", "open", "rally"],
                "minLength": 4,
                "maxLength": 6
              },
              "wing": {
                "type": "string",
                "enum": ["high", "low", "none"],
                "minLength": 3,
                "maxLength": 4
              },
              "wheels": {
                "type": "string",
                "enum": ["all-terrain", "slick", "street"],
                "minLength": 5,
                "maxLength": 11
              },
              "palette": {
                "type": "string",
                "enum": ["magenta", "mint", "redline", "sunburst", "turbo-blue"],
                "minLength": 4,
                "maxLength": 10
              },
              "trail": {
                "type": "string",
                "enum": ["grid", "none", "spark"],
                "minLength": 4,
                "maxLength": 5
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "weeklyScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7000
          },
          "activeDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "sourceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "rankPosition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "displayPosition": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        }
      }
    }
  }
}
