{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/connector-car-proposal-result.schema.json",
  "title": "ConnectorCarProposalResultV1",
  "description": "Generic acknowledgement that one authenticated device proposal was stored for explicit browser review. It exposes no proposal or profile identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "outcome"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]{22}$",
      "minLength": 26,
      "maxLength": 26
    },
    "outcome": {
      "type": "string",
      "const": "accepted",
      "minLength": 8,
      "maxLength": 8
    }
  }
}
