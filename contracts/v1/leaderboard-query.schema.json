{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/leaderboard-query.schema.json",
  "title": "LeaderboardQueryV1",
  "description": "Closed single-value query for one server-sized Community leaderboard snapshot page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trustTier", "page"],
  "properties": {
    "trustTier": {
      "description": "Competitive self-reported Community tier.",
      "type": "string",
      "const": "community",
      "minLength": 9,
      "maxLength": 9
    },
    "page": {
      "description": "Canonical positive page number. The server fixes page size to 100.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
