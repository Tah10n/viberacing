{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/problem-details.schema.json",
  "title": "ProblemDetailsV1",
  "description": "Bounded public error response that carries a request ID and stable code without stack traces, SQL details, secrets, or internal hostnames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "status", "errorCode", "title", "retryable"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^req_[A-Za-z0-9_-]{22}$"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "conflict",
        "forbidden",
        "internal_error",
        "invalid_request",
        "method_not_allowed",
        "not_acceptable",
        "not_found",
        "rate_limited",
        "temporarily_unavailable",
        "unauthorized",
        "validation_failed"
      ],
      "minLength": 8,
      "maxLength": 23
    },
    "title": {
      "type": "string",
      "enum": [
        "Conflict",
        "Forbidden",
        "Internal server error",
        "Invalid request",
        "Method not allowed",
        "Not acceptable",
        "Not found",
        "Rate limited",
        "Temporarily unavailable",
        "Unauthorized",
        "Validation failed"
      ],
      "minLength": 1,
      "maxLength": 23
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
