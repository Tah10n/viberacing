{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/car-recipe.schema.json",
  "title": "CarRecipeV1",
  "description": "Closed project-owned pixel-car recipe. It contains no text, color, URL, path, file, markup, shader, executable instruction, or conversation content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chassis",
    "nose",
    "cockpit",
    "wing",
    "wheels",
    "palette",
    "trail",
    "seed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "chassis": {
      "type": "string",
      "enum": ["formula", "rally", "roadster"],
      "minLength": 5,
      "maxLength": 8
    },
    "nose": {
      "type": "string",
      "enum": ["classic", "scoop", "wedge"],
      "minLength": 5,
      "maxLength": 7
    },
    "cockpit": {
      "type": "string",
      "enum": ["canopy", "open", "rally"],
      "minLength": 4,
      "maxLength": 6
    },
    "wing": {
      "type": "string",
      "enum": ["high", "low", "none"],
      "minLength": 3,
      "maxLength": 4
    },
    "wheels": {
      "type": "string",
      "enum": ["all-terrain", "slick", "street"],
      "minLength": 5,
      "maxLength": 11
    },
    "palette": {
      "type": "string",
      "enum": ["magenta", "mint", "redline", "sunburst", "turbo-blue"],
      "minLength": 4,
      "maxLength": 10
    },
    "trail": {
      "type": "string",
      "enum": ["grid", "none", "spark"],
      "minLength": 4,
      "maxLength": 5
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  }
}
