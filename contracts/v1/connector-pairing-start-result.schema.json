{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/connector-pairing-start-result.schema.json",
  "title": "ConnectorPairingStartResultV1",
  "description": "One-time short-lived pairing material returned only after a pending transaction is committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "pairingId",
    "pollToken",
    "pairingChallengeBase64Url",
    "userCode",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^req_[A-Za-z0-9_-]{22}$"
    },
    "pairingId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pollToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "pairingChallengeBase64Url": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "userCode": {
      "type": "string",
      "minLength": 14,
      "maxLength": 14,
      "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
