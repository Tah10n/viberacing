{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/usage-sync.schema.json",
  "title": "UsageSyncV1",
  "description": "Bounded provider-neutral Community usage submitted by one AgentAccount-bound device. Provider attribution, accounting revision, ranking, and trust fields are server-owned and intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentAccountId",
    "syncId",
    "observedAt",
    "clientVersion",
    "readerVersion",
    "dailyEntries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "agentAccountId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^acc_[A-Za-z0-9_-]{22}$"
    },
    "syncId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^syn_[A-Za-z0-9_-]{22}$"
    },
    "observedAt": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "format": "date-time"
    },
    "clientVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "readerVersion": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "dailyEntries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "x-viberacing-uniqueBy": "usageDate",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["usageDate", "dailyTokenTotal"],
        "properties": {
          "usageDate": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "dailyTokenTotal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^(?:0|[1-9][0-9]{0,29})$"
          }
        }
      }
    }
  }
}
