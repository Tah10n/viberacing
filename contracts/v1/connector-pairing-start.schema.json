{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viberacing.example/v1/connector-pairing-start.schema.json",
  "title": "ConnectorPairingStartV1",
  "description": "Closed anonymous batch-pairing request containing only a privacy-minimized discovery manifest, fresh installation-key possession proof, and non-authoritative rate identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "discoveryManifest",
    "installationPossessionProof",
    "clientRateIdentifier"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "minimum": 1,
      "maximum": 1
    },
    "discoveryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "installationPublicKey",
        "connectorVersion",
        "osFamily",
        "architecture",
        "candidates"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1,
          "minimum": 1,
          "maximum": 1
        },
        "installationPublicKey": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "connectorVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "osFamily": {
          "type": "string",
          "enum": ["linux", "macos", "windows"],
          "minLength": 5,
          "maxLength": 7
        },
        "architecture": {
          "type": "string",
          "enum": ["aarch64", "x86_64"],
          "minLength": 6,
          "maxLength": 7
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "x-viberacing-uniqueBy": "candidateId",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "x-viberacing-optionalProperties": ["accountFingerprintDigest"],
            "required": [
              "candidateId",
              "provider",
              "readerVersion",
              "accountingRevision",
              "scopeKind",
              "fingerprintKind",
              "safeDisplayLabel",
              "syncPublicKey",
              "preview"
            ],
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 27,
                "maxLength": 27,
                "pattern": "^cand_[A-Za-z0-9_-]{22}$"
              },
              "provider": {
                "type": "string",
                "enum": ["codex"],
                "minLength": 5,
                "maxLength": 5
              },
              "readerVersion": {
                "type": "string",
                "minLength": 3,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "accountingRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999
              },
              "scopeKind": {
                "type": "string",
                "const": "agent_account",
                "minLength": 13,
                "maxLength": 13
              },
              "fingerprintKind": {
                "type": "string",
                "enum": ["stable_opaque", "unavailable"],
                "minLength": 11,
                "maxLength": 13
              },
              "accountFingerprintDigest": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "safeDisplayLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
              },
              "syncPublicKey": {
                "type": "string",
                "minLength": 43,
                "maxLength": 43,
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "preview": {
                "type": "object",
                "additionalProperties": false,
                "required": ["currentWeekTokenTotal", "lastUsageDate", "status"],
                "properties": {
                  "currentWeekTokenTotal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^(?:0|[1-9][0-9]{0,59})$"
                  },
                  "lastUsageDate": {
                    "type": ["string", "null"],
                    "minLength": 10,
                    "maxLength": 10,
                    "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
                    "format": "date"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ready",
                      "incomplete_period",
                      "reader_error",
                      "unavailable",
                      "unsupported_scope",
                      "unsupported_version"
                    ],
                    "minLength": 5,
                    "maxLength": 19
                  }
                }
              }
            }
          }
        }
      }
    },
    "installationPossessionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signedAt", "nonce", "signature"],
      "properties": {
        "signedAt": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "nonce": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "clientRateIdentifier": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}$"
    }
  }
}
