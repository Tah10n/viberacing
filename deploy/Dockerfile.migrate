FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS manifests

ENV CI=true

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/migrate/package.json apps/migrate/package.json

FROM manifests AS build

RUN corepack pnpm install --filter @viberacing/migrate... --frozen-lockfile --ignore-scripts

COPY apps/migrate apps/migrate

RUN corepack pnpm --filter @viberacing/migrate run build

FROM manifests AS production-dependencies

RUN corepack pnpm install \
  --filter @viberacing/migrate... \
  --prod \
  --frozen-lockfile \
  --ignore-scripts

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime

ENV NODE_ENV=production

WORKDIR /app

COPY --from=production-dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=production-dependencies --chown=node:node /workspace/apps/migrate/node_modules ./apps/migrate/node_modules
COPY --from=build --chown=node:node /workspace/apps/migrate/package.json ./apps/migrate/package.json
COPY --from=build --chown=node:node /workspace/apps/migrate/dist ./apps/migrate/dist
COPY --chown=node:node database/migrations ./database/migrations

USER node

STOPSIGNAL SIGTERM

CMD ["node", "apps/migrate/dist/main.js"]
