{
  "name": "@viberacing/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "dev": "next dev --hostname localhost",
    "lint": "eslint .",
    "prebuild": "node scripts/package-connector.mjs",
    "predev": "node scripts/package-connector.mjs",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.11",
    "pg": "8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
