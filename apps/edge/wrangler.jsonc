{
  "name": "viberacing-ingest-edge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "vars": {
    "VIBERACING_USAGE_SYNC_ENABLED": "false",
  },
  "ratelimits": [
    {
      "name": "VIBERACING_USAGE_GLOBAL_BURST",
      "namespace_id": "320001",
      "simple": { "limit": 240, "period": 10 },
    },
    {
      "name": "VIBERACING_USAGE_GLOBAL_SUSTAINED",
      "namespace_id": "320002",
      "simple": { "limit": 900, "period": 60 },
    },
    {
      "name": "VIBERACING_USAGE_IP_BURST",
      "namespace_id": "320003",
      "simple": { "limit": 20, "period": 10 },
    },
    {
      "name": "VIBERACING_USAGE_IP_SUSTAINED",
      "namespace_id": "320004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "VIBERACING_USAGE_DEVICE_BURST",
      "namespace_id": "320005",
      "simple": { "limit": 10, "period": 10 },
    },
    {
      "name": "VIBERACING_USAGE_DEVICE_SUSTAINED",
      "namespace_id": "320006",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "VIBERACING_USAGE_BYTE_BUDGET",
      "namespace_id": "320007",
      "simple": { "limit": 2048, "period": 60 },
    },
  ],
}
