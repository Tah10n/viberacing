# Public schema only. Copy values into an ignored .env file for local work.
# Never place production, staging, or personal values in this file.

NODE_ENV=development
VIBERACING_LOG_LEVEL=debug

# Optional for local Phase 1; required before any hosted deployment. This is a public origin, not a
# secret. Production must use an HTTPS DNS origin with no path, query, fragment, credentials, or
# non-default port. If omitted, local builds use loopback and production builds use a reserved
# non-routable .example origin so private workstation values are never inferred.
VIBERACING_PUBLIC_ORIGIN=http://localhost:3000

# Disposable local PostgreSQL bootstrap/migration owner from compose.yaml. The Web adapter must not
# consume these owner credentials.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54329
DATABASE_NAME=viberacing_local
DATABASE_USER=viberacing_local
DATABASE_PASSWORD=local-development-only

# Server-only public-score adapter. The repository does not create this LOGIN principal: provision a
# distinct local login outside the repository, grant it only viberacing_web, and replace both
# placeholders in an ignored .env file. Cleartext requires explicit development/test plus loopback;
# every other environment requires verify-full with a certificate-valid DNS hostname.
VIBERACING_WEB_DATABASE_HOST=127.0.0.1
VIBERACING_WEB_DATABASE_PORT=54329
VIBERACING_WEB_DATABASE_NAME=viberacing_local
VIBERACING_WEB_DATABASE_USER=replace_with_local_web_login
VIBERACING_WEB_DATABASE_PASSWORD=replace-with-local-web-password
VIBERACING_WEB_DATABASE_TLS_MODE=disable

# Server-only pairing poll-token verifier. Replace this intentionally invalid public placeholder
# with one freshly generated 32-byte canonical base64url key in an ignored local environment. A
# previous primary may be supplied separately as the optional secondary only during the bounded
# ten-minute pairing overlap; never track either real value.
VIBERACING_WEB_PAIRING_POLL_PRIMARY_KEY_BASE64URL=replace-with-random-32-byte-base64url-key
# Rotation-only optional name: VIBERACING_WEB_PAIRING_POLL_SECONDARY_KEY_BASE64URL
# Use separate material for the low-entropy human code verifier; the application rejects reuse of
# either poll key. Its optional secondary has the same bounded rotation-only purpose.
VIBERACING_WEB_PAIRING_CODE_PRIMARY_KEY_BASE64URL=replace-with-distinct-random-32-byte-base64url-key
# Rotation-only optional name: VIBERACING_WEB_PAIRING_CODE_SECONDARY_KEY_BASE64URL

# Local one-shot Jobs runner. Provision a second distinct login outside the repository, grant it
# only viberacing_jobs, and replace both placeholders in an ignored .env file. Transport rules are
# identical to the Web adapter; these values are never needed by the synthetic site or its build.
VIBERACING_JOBS_DATABASE_HOST=127.0.0.1
VIBERACING_JOBS_DATABASE_PORT=54329
VIBERACING_JOBS_DATABASE_NAME=viberacing_local
VIBERACING_JOBS_DATABASE_USER=replace_with_local_jobs_login
VIBERACING_JOBS_DATABASE_PASSWORD=replace-with-local-jobs-password
VIBERACING_JOBS_DATABASE_TLS_MODE=disable

# Server-only invite enrollment. The local flow fails closed until an OAuth app and fresh secrets
# are supplied in an ignored environment. Configure the OAuth callback as
# http://localhost:3000/auth/github/callback. SESSION_SECRET must be exactly one canonical 32-byte
# base64url value (43 characters); the tracked placeholder is intentionally invalid. WebAuthn origin
# must exactly match VIBERACING_PUBLIC_ORIGIN and the RP ID must equal that origin's DNS hostname;
# use localhost rather than a numeric loopback address for the local WebAuthn ceremony.
GITHUB_CLIENT_ID=replace-with-local-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-local-oauth-client-secret
SESSION_SECRET=replace-with-fresh-32-byte-base64url-value
# Recovery uses a separate protected pepper so rotating SESSION_SECRET does not invalidate saved
# recovery codes. Select and protect deployment-specific work factors outside this public file.
VIBERACING_RECOVERY_PEPPER=replace-with-distinct-32-byte-base64url-value
VIBERACING_RECOVERY_ARGON2_MEMORY_KIB=replace-with-reviewed-memory-kib
VIBERACING_RECOVERY_ARGON2_PASSES=replace-with-reviewed-pass-count
VIBERACING_RECOVERY_ARGON2_PARALLELISM=replace-with-reviewed-parallelism
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
