# Local example. VIBERACING_PUBLIC_ORIGIN must use HTTPS in production.
DATABASE_URL=postgresql://viberacing:viberacing@localhost:55432/viberacing
VIBERACING_PUBLIC_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set true only when DATABASE_URL points at a TLS-enabled PostgreSQL endpoint.
VIBERACING_DATABASE_SSL=false
