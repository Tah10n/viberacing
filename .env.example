# Local example. VIBERACING_PUBLIC_ORIGIN must use HTTPS in production.
DATABASE_URL=postgresql://viberacing:viberacing@localhost:55432/viberacing
VIBERACING_PUBLIC_ORIGIN=http://localhost:3000
# Local production-container exception; never set this in Railway.
VIBERACING_ALLOW_INSECURE_LOCAL=true
# Local preview only. Public production must use railway or trusted-x-real-ip.
# trusted-x-real-ip requires a reverse proxy that removes the client header and overwrites it.
VIBERACING_TRUST_PROXY=none
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set true only when DATABASE_URL points at a TLS-enabled PostgreSQL endpoint.
VIBERACING_DATABASE_SSL=false
# Optional. Use "npm" only after @viberacing/connector is published and verified.
VIBERACING_CONNECTOR_DISTRIBUTION=archive
VIBERACING_MIN_CONNECTOR_VERSION=0.2.0
VIBERACING_MAX_DAILY_TOKENS=9999999999999999
VIBERACING_LOG_LEVEL=info
